# Runs the Playwright end-to-end tests on the real build before a push, for
# the apps that the push can change. A failed test refuses the push. HUSKY=0
# skips every hook.

base=origin/main

if git fetch --quiet origin main 2>/dev/null; then
  # A push of documents or of unit tests, with their fixtures and their
  # setup, changes no built app and no flow: it has nothing to run.
  if git diff --quiet "$base"...HEAD -- apps packages package.json \
    pnpm-lock.yaml pnpm-workspace.yaml turbo.json \
    ':(exclude,glob)**/__tests__/**' ':(exclude,glob)**/__fixtures__/**' \
    ':(exclude,glob)*/*/test/**' ':(exclude,glob)**/*.test.ts' \
    ':(exclude,glob)**/*.test.tsx' ':(exclude,glob)**/*.md'; then
    echo "pre-push: the push changes no built app and no flow. No end-to-end run."
    exit 0
  fi
  # turbo names each package that the push changes, and each package that
  # depends on one. When it gives no answer, each app runs.
  affected="$(TURBO_SCM_BASE="$base" pnpm exec turbo ls --affected --output=json 2>/dev/null || true)"
  # The setup of a run reaches each flow of each app.
  if ! git diff --quiet "$base"...HEAD -- packages/e2e/playwright.config.ts \
    packages/e2e/package.json packages/e2e/support/apps.ts \
    packages/e2e/support/session.setup.ts; then
    affected=""
  fi
else
  # The first push of a repo has no origin/main to compare with: each app runs.
  affected=""
fi

# For each app: "all" its flows when the push changes the app or a package
# that it uses, the "changed" flows when the push changes only flow files or
# their helpers (Playwright follows the imports of each flow file), or nothing.
plan=""
for app in {{APP_NAMES}}; do
  ls "packages/e2e/flows/$app"/*.spec.ts >/dev/null 2>&1 || continue
  if [ -z "$affected" ] || printf '%s' "$affected" | grep -q "\"apps/$app\""; then
    plan="$plan $app:all"
  elif printf '%s' "$affected" | grep -q '"packages/e2e"' &&
    ! APP="$app" pnpm flows --only-changed="$base" --list 2>/dev/null |
      grep -q "Total: 0 tests"; then
    plan="$plan $app:changed"
  fi
done

if [ -z "$plan" ]; then
  echo "pre-push: the push changes no app that has a flow. No end-to-end run."
  exit 0
fi
echo "pre-push: the end-to-end run of this push:$plan"

# One run at a time on this machine: each worktree uses the same ports and
# the same database, so a second push waits for the first.
lock="$(git rev-parse --path-format=absolute --git-common-dir)/e2e.lock"
waited=0
until mkdir "$lock" 2>/dev/null; do
  if [ "$waited" -ge 1200 ]; then
    echo "pre-push: another end-to-end run holds $lock for 20 minutes. Remove the folder when no run is active."
    exit 1
  fi
  sleep 10
  waited=$((waited + 10))
done
trap 'rmdir "$lock"' EXIT
trap 'exit 1' INT TERM

for item in $plan; do
  app="${item%%:*}"
  only=""
  if [ "${item##*:}" = changed ]; then
    only="--only-changed=$base"
  fi
  # shellcheck disable=SC2086 -- $only is one flag or nothing
  APP="$app" pnpm flows $only || {
    echo "pre-push: an end-to-end test of $app failed. Open packages/e2e/.output/report/$app-flows/index.html."
    exit 1
  }
done
