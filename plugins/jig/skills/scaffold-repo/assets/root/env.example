# One Postgres database for every app: the Supabase session-pooler URI (port 5432).
# Supabase dashboard → Connect → Session pooler. The transaction pooler (6543)
# rejects prepared statements, which the postgres.js driver uses.
DATABASE_URL=
# Auth.js secret. Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Print the call trace block for every request: 1 on, unset off.
TRACE_LOG=
