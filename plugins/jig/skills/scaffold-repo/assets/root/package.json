{
  "name": "{{REPO}}",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test:run --concurrency=1",
    "test:changed": "turbo run test:changed --concurrency=1",
    "verify": "turbo run lint typecheck build test:run",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "screens": "pnpm --filter {{SCOPE}}/e2e screens",
    "flows": "pnpm --filter {{SCOPE}}/e2e flows",
    "flows:all": "for dir in packages/e2e/flows/*/; do APP=$(basename \"$dir\") pnpm flows || exit 1; done"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "bun": "^1.4.4",
    "dotenv-cli": "^11.0.0",
    "lefthook": "^2.2.2",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "turbo": "^2",
    "typescript": "^7.0.2"
  }
}
